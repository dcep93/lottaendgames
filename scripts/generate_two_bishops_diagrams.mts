const degenerateDiagonalSetupFen = getChess(
  '8/4B3/5K2/7k/8/8/2B5/8 w - - 2 2',
).fen()
const degenerateDiagonalWaitingMoveFen = getChess(
  '4B1k1/8/4KB2/8/8/8/8/8 w - - 2 2',
