).fen()
const degenerateLongDiagonalFen = getChess(
  '8/8/4B3/8/8/5K2/5B1k/8 w - - 0 1',
).fen()
const degenerateFreeBishopFen = getChess(
  '2B5/8/8/8/8/8/5K2/4B2k w - - 2 2',
).fen()
const degenerateWaitingMoveFen = getChess(
  '5B1k/1B3K2/8/8/8/8/8/8 w - - 0 1',
).fen()
const degenerateEdgeRepairFen = getChess(
  '8/8/8/8/8/7k/5K2/3BB3 w - - 2 2',
).fen()
const degenerateEdgeUnmaskFen = getChess(
  '8/8/8/8/8/7k/2B2K2/4B3 w - - 2 2',
